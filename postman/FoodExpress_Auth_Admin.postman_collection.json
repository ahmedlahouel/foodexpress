{
  "info": {
    "name": "FoodExpress - Auth and Admin",
    "description": "Set adminEmail/adminPassword, clientEmail/clientPassword, restoEmail/restoPassword to the seed accounts, then run the collection in order (Runner). A1 creates a fresh test user on every run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "A1 Register OK",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newEmail\", \"user\" + Date.now() + \"@test.tn\");",
                  "pm.collectionVariables.set(\"newPassword\", \"Secret123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenNew\", res.token);",
                  "pm.collectionVariables.set(\"newUserId\", res.user._id);",
                  "pm.test(\"role is client\", () => pm.expect(res.user.role).to.eql(\"client\"));",
                  "pm.test(\"no password in response\", () => pm.expect(JSON.stringify(res)).to.not.include(\"password\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Ali\",\n  \"prenom\": \"Test\",\n  \"email\": \"{{newEmail}}\",\n  \"telephone\": \"22123456\",\n  \"password\": \"{{newPassword}}\",\n  \"confirmation\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
